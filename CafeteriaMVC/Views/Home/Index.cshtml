@{
    ViewData["Title"] = "Inicio";
}

<div class="hero">
    <h1>El arte del buen café</h1>
    <p>Granos seleccionados de altura, tostados artesanalmente cada mañana en un espacio diseñado para ti.</p>
    <a asp-controller="Home" asp-action="Reservas" class="btn-principal">Reservar una mesa</a>
</div>

<div class="grid-menu">
    <div class="card-producto">
        <h3>📍 Nuestra Ubicación</h3>
        <p>Av. Arce #2450, Zona Sopocachi, La Paz. Ambiente tranquilo con Wi-Fi de alta velocidad.</p>
    </div>
    <div class="card-producto">
        <h3>🕒 Horarios de Atención</h3>
        <p>Lunes a Viernes: 07:30 - 21:00<br>Sábados y Domingos: 08:30 - 22:00</p>
    </div>
    <div class="card-producto">
        <h3>🥐 Repostería del Día</h3>
        <p>Croissants, rolls de canela y pasteles recién horneados cada mañana para acompañar tu café.</p>
    </div>
</div>