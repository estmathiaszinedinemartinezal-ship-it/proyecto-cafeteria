@using CafeteriaMVC.Models
@{
    ViewData["Title"] = "Panel Admin";
    var productos = ViewBag.Productos as List<Producto> ?? new();
    var reservas  = ViewBag.Reservas  as List<Reserva>  ?? new();
    var mensajes  = ViewBag.Mensajes  as List<Mensaje>  ?? new();

    var prodEditar = ViewBag.ProdEditar as Producto;
    var resEditar  = ViewBag.ResEditar  as Reserva;
    var msgEditar  = ViewBag.MsgEditar  as Mensaje;
}

@if (TempData["Alerta"] != null)
{
    <div class="alerta">@TempData["Alerta"]</div>
}

<!-- 1. CRUD PRODUCTOS -->
<h2>☕ Gestión de Productos (Crear, Listar, Editar, Borrar)</h2>
<form method="post" asp-action="GuardarProducto">
    <input type="hidden" name="Id" value="@(prodEditar?.Id ?? 0)" />
    <div class="fila-form">
        <input type="text" name="Nombre" placeholder="Nombre del producto" value="@(prodEditar?.Nombre ?? "")" required />
        <select name="Categoria" required>
            <option value="Café Caliente" selected="@(prodEditar?.Categoria == "Café Caliente")">Café Caliente</option>
            <option value="Bebidas Frías" selected="@(prodEditar?.Categoria == "Bebidas Frías")">Bebidas Frías</option>
            <option value="Repostería" selected="@(prodEditar?.Categoria == "Repostería")">Repostería</option>
        </select>
    </div>
    <div class="fila-form">
        <input type="text" name="Descripcion" placeholder="Descripción" value="@(prodEditar?.Descripcion ?? "")" required />
        <input type="number" step="0.50" name="Precio" placeholder="Precio en Bs." value="@(prodEditar?.Precio ?? 0)" required />
    </div>
    <button type="submit">@(prodEditar != null ? "Guardar Cambios del Producto" : "+ Crear Producto")</button>
</form>

<table>
    <tr><th>Producto</th><th>Categoría</th><th>Precio</th><th>Acciones</th></tr>
    @foreach (var p in productos)
    {
        <tr>
            <td><strong>@p.Nombre</strong></td>
            <td>@p.Categoria</td>
            <td>Bs. @p.Precio.ToString("0.00")</td>
            <td>
                <a asp-action="Admin" asp-route-editarProd="@p.Id" class="btn-editar">Editar</a>
                <a asp-action="BorrarProducto" asp-route-id="@p.Id" class="btn-eliminar">Borrar</a>
            </td>
        </tr>
    }
</table>

<!-- 2. CRUD RESERVAS -->
<h2>📅 Gestión de Reservas (Crear, Listar, Editar, Borrar)</h2>
<form method="post" asp-action="GuardarReserva">
    <input type="hidden" name="Id" value="@(resEditar?.Id ?? 0)" />
    <div class="fila-form">
        <input type="text" name="NombreCliente" placeholder="Nombre del cliente" value="@(resEditar?.NombreCliente ?? "")" required />
        <input type="email" name="Correo" placeholder="Correo" value="@(resEditar?.Correo ?? "")" required />
    </div>
    <div class="fila-form">
        <input type="date" name="Fecha" value="@(resEditar != null ? resEditar.Fecha.ToString("yyyy-MM-dd") : "")" required />
        <input type="time" name="Hora" value="@(resEditar?.Hora ?? "")" required />
    </div>
    <input type="number" name="Personas" placeholder="Personas" value="@(resEditar?.Personas ?? 2)" min="1" max="15" required />
    <button type="submit">@(resEditar != null ? "Guardar Cambios de Reserva" : "+ Crear Reserva")</button>
</form>

<table>
    <tr><th>Cliente</th><th>Correo</th><th>Fecha y Hora</th><th>Personas</th><th>Acciones</th></tr>
    @foreach (var r in reservas)
    {
        <tr>
            <td><strong>@r.NombreCliente</strong></td>
            <td>@r.Correo</td>
            <td>@r.Fecha.ToString("yyyy-MM-dd") - @r.Hora</td>
            <td>@r.Personas</td>
            <td>
                <a asp-action="Admin" asp-route-editarRes="@r.Id" class="btn-editar">Editar</a>
                <a asp-action="BorrarReserva" asp-route-id="@r.Id" class="btn-eliminar">Borrar</a>
            </td>
        </tr>
    }
</table>

<!-- 3. CRUD MENSAJES -->
<h2>📩 Gestión de Mensajes (Crear, Listar, Editar, Borrar)</h2>
<form method="post" asp-action="GuardarMensaje">
    <input type="hidden" name="Id" value="@(msgEditar?.Id ?? 0)" />
    <div class="fila-form">
        <input type="text" name="Nombre" placeholder="Nombre" value="@(msgEditar?.Nombre ?? "")" required />
        <input type="email" name="Correo" placeholder="Correo" value="@(msgEditar?.Correo ?? "")" required />
    </div>
    <textarea name="Texto" rows="2" placeholder="Mensaje" required>@(msgEditar?.Texto ?? "")</textarea>
    <button type="submit">@(msgEditar != null ? "Guardar Cambios del Mensaje" : "+ Crear Mensaje")</button>
</form>

<table>
    <tr><th>Fecha</th><th>Nombre</th><th>Correo</th><th>Mensaje</th><th>Acciones</th></tr>
    @foreach (var m in mensajes)
    {
        <tr>
            <td>@m.FechaEnvio.ToString("yyyy-MM-dd HH:mm")</td>
            <td><strong>@m.Nombre</strong></td>
            <td>@m.Correo</td>
            <td>@m.Texto</td>
            <td>
                <a asp-action="Admin" asp-route-editarMsg="@m.Id" class="btn-editar">Editar</a>
                <a asp-action="BorrarMensaje" asp-route-id="@m.Id" class="btn-eliminar">Borrar</a>
            </td>
        </tr>
    }
</table>